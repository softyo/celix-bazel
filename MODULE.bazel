# Apache Celix as a Bazel module.
#
# This module vendors a snapshot of the Apache Celix 2.4.0 source tree (the
# framework core + libs/utils) and exposes it as native cc_library targets so
# that consumers can link the framework into their Bazel builds. It is
# independent of rules_celix, the packaging ruleset that consumes this module.
module(
    name = "celix",
    version = "2.4.0",
    compatibility_level = 1,
)

# rules_cc 0.1.0+ is required: 0.0.9 loads its C++ toolchain via
# use_extension("@bazel_tools//tools/cpp:cc_configure.bzl",
# "cc_configure_extension"), a file that Bazel 8 replaced with a redirect that
# only exports cc_configure/MSVC_ENVVARS. The BCR presubmit matrix runs Bazel
# 7.x and 8.x, so the extension must come from @rules_cc//cc:extensions.bzl
# (rules_cc 0.1.0+). 0.1.5 is the latest 0.1.x and stays lightweight; 0.2.x is
# Bazel 8-only and drags in protobuf/apple_support, so do not use it.
bazel_dep(name = "rules_cc", version = "0.1.5")
bazel_dep(name = "platforms", version = "0.0.11")

# Dev-only: hermetic Starlark formatter (buildifier)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# Framework hard deps: libzip (used by libs/utils celix_file_utils.c) and zlib
# (libzip's DEFLATE backend) are vendored under third_party/ as native
# cc_library overlays, matching rules_celix's hermetic build. The BCR libzip
# module is not used because it builds via rules_foreign_cc CMake, which
# requires a host cmake toolchain and drags in boringssl/zstd.
